# ─── Node.js 依赖 ─────────────────────────────────────────
# 忽略所有 node_modules 文件夹
**/node_modules/

# ─── 环境变量 ───────────────────────────────────────────
# 忽略所有以 .env 命名的文件
**/.env

# ─── 构建输出 ───────────────────────────────────────────
# Vite 默认输出目录
/front_end/dist/
/front_end/.vite/

# 如果后端也有编译/打包目录（比如 build/、dist/），可以加上：
# /back_end/dist/
/back_end/build/

# ─── 编辑器 & IDE ────────────────────────────────────────
# VSCode 配置
**/.vscode/


# ─── Cursor 本地缓存 ─────────────────────────────────────
# 忽略 .cursor 目录（只保留 .cursorignore）
.cursor/

# ─── 日志 & 操作系统垃圾文件 ─────────────────────────────
# 日志文件
*.log
npm-debug.log*
yarn-debug.log*



# Windows 缓存
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── 可选：测试覆盖率、临时文件 ───────────────────────────
coverage/
*.tmp