# 环境配置示例文件
# 复制此文件为 .env 并修改相应的配置值
# 注意：.env 文件包含敏感信息，不应提交到版本控制系统

# ===========================================
# 应用基础配置
# ===========================================

# 应用运行环境 (development/test/staging/production)
NODE_ENV=development

# 服务器配置
PORT=3000
HOST=localhost

# API 配置
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8080

# ===========================================
# 数据库配置
# ===========================================

# 主数据库配置 (开发环境)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vehicle_repair_system_dev
DB_USER=root
DB_PASSWORD=c5f91704

# 测试数据库配置
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=vehicle_repair_system_test
TEST_DB_USER=root
TEST_DB_PASSWORD=c5f91704

# 数据库连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===========================================
# 安全配置
# ===========================================

# JWT 配置
JWT_SECRET=your-secret-key-for-jwt-token
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-here-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# 会话配置
SESSION_SECRET=your-session-secret-key-here
SESSION_MAX_AGE=86400000

# 密码加密轮数
BCRYPT_ROUNDS=10

# ===========================================
# 日志配置
# ===========================================

# 日志级别 (error/warn/info/debug)
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===========================================
# 文件上传配置
# ===========================================

# 上传目录
UPLOAD_DIR=uploads
# 最大文件大小 (字节)
MAX_FILE_SIZE=10485760
# 允许的文件类型
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ===========================================
# 第三方服务配置 (可选)
# ===========================================

# Redis 配置 (如果使用)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# 邮件服务配置 (如果使用)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_email_password
# EMAIL_FROM=noreply@yourapp.com

# 短信服务配置 (如果使用)
# SMS_API_KEY=your_sms_api_key
# SMS_API_SECRET=your_sms_api_secret

# ===========================================
# 开发工具配置
# ===========================================

# 是否启用调试模式
DEBUG=false
# 是否启用 API 文档
ENABLE_DOCS=true
# 是否启用请求日志
ENABLE_REQUEST_LOG=true 